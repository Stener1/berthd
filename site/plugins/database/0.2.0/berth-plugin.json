{
  "id": "database",
  "name": "Database",
  "version": "0.2.0",
  "description": "A worktree's own development database, as a tab on the worktree: browse its tables, edit rows and run SQL, read-only until you unlock it. Postgres for now. Installs berth-database on the boxes you turn it on for.",
  "main": "dist/index.js",
  "defaultEnabled": false,
  "author": "Shipyard",
  "homepage": "https://github.com/cosscom/shipyard/tree/main/plugins/database",
  "box": {
    "helper": {
      "name": "berth-database",
      "version": "0.1.0",
      "args": [
        "serve",
        "--dir",
        "{dir}",
        "--addr",
        "127.0.0.1:0"
      ],
      "ready": "helper.json",
      "attach": "/api/attach",
      "detach": "/api/detach",
      "attach_env": [
        "DATABASE_URL",
        "POSTGRES_URL"
      ],
      "assets": {
        "linux-amd64": {
          "url": "https://github.com/cosscom/shipyard/releases/download/database-helper-v0.1.0/berth-database-linux-amd64",
          "sha256": "9944e1b9a706346d813699238c6ef1ba79c80d42c8fea0231c1532e292d28d10",
          "size": 8487072
        },
        "linux-arm64": {
          "url": "https://github.com/cosscom/shipyard/releases/download/database-helper-v0.1.0/berth-database-linux-arm64",
          "sha256": "df22bc87fe50611f841697c7cb26ed1addddc2a1368a15d1dd2599615dc59a1d",
          "size": 7930016
        },
        "darwin-arm64": {
          "url": "https://github.com/cosscom/shipyard/releases/download/database-helper-v0.1.0/berth-database-darwin-arm64",
          "sha256": "44c4fb1a9ec2b486fa97b1eeb69545687b5c6db8b3f246f3cde587c8b775fcd8",
          "size": 8094082
        },
        "darwin-amd64": {
          "url": "https://github.com/cosscom/shipyard/releases/download/database-helper-v0.1.0/berth-database-darwin-amd64",
          "sha256": "6d97e3220e8b4e8ea210e3a9928599ab63c1b2fbf0718e3968f62bbf42e539dc",
          "size": 8687056
        }
      }
    }
  }
}
